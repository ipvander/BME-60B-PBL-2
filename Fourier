%testShazam script
% Script to test our Shazam function on known and unknown sound clips
clear; clc; close all;
fprintf('Testing Shazam.m\n\n');

% Prompts user to select the top-level folder
topFolder = uigetdir(pwd, 'Select top-level Sound Clips folder');
chosenFolder = fullfile(topFolder, 'Chosen Clips'); %Opens chosen clips

% Test all of the 4 known sound files
knownFiles = { ...
    'animals.aifc', ...
    'classical.aifc', ...
    'country.aifc', ...
    'edm.aifc' };
knownLabels = { ...
    'Animals', ...
    'Classical', ...
    'Country', ...
    'EDM' };
fprintf('Known files:\n');
for k = 1:numel(knownFiles)
    file = fullfile(chosenFolder, knownFiles{k}); %selects file from folder
    expected = knownLabels{k}; %Sets expected output to file name
    if exist(file, 'file')
        musicType = Shazam(file); %run function through each sound file
        fprintf('Expected: %s\n\n', expected); %Prints expected output
    else
        fprintf('  File not found in current folder. Skipping.\n\n');
    end
end

% Other/unknown files in top-level folder (or subfolders)
% Get all .aifc files in topFolder and subfolders
unknownFolder = topFolder;

% Runs Shazam on select unknown files and print results
unknownFiles = { ...
    'blue.aifc', ...
    'despacito.aifc', ...
    'lion.aifc'};
fprintf('Testing Unknown Files:\n\n');
for k = 1:numel(unknownFiles)
    file = fullfile(unknownFolder, unknownFiles{k}); %selects file
    fprintf('Testing file: %s\n', file);
    if exist(file, 'file') %Checks to see if file is found
        musicType = Shazam(file); %Runs function on unknown file
        fprintf('  Shazam classification: %s\n\n', musicType); %Outputs class
    else
        fprintf('  File not found in current folder. Skipping.\n\n');
    end
end
fprintf('All tests complete.\n');
