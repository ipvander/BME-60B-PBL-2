    % ---------- Peak analysis ----------
    [Peaks, Locs] = findpeaks(psdx, freq);

    % Fundamental frequency
    [~, idxMax] = max(Peaks);
    fundFreq = Locs(idxMax);

    % Top 5% power of fundamental
    threshold = 0.05 * Peaks(idxMax);
    sigIdx = Peaks >= threshold;
    sigFreqs = Locs(sigIdx);
    numSigPeaks = sum(sigIdx);

    % Mean spacing of significant peaks
    if numSigPeaks > 1
        meanSpacing = mean(diff(sort(sigFreqs)));
    else
        meanSpacing = NaN;
    end

    % ---------- Point system ----------
    % Define benchmark ranges based on your analysis
    benchmarks = struct();
    benchmarks.Animal  = struct('fundRange',[900 920],'numSig',1000,'meanSpacing',2);
    benchmarks.Classical = struct('fundRange',[1070 1080],'numSig',130,'meanSpacing',3.5);
    benchmarks.Country = struct('fundRange',[880 890],'numSig',360,'meanSpacing',5);
    benchmarks.EDM = struct('fundRange',[30 35],'numSig',5,'meanSpacing',17);

    types = fieldnames(benchmarks);
    scores = zeros(length(types),1);

    for k = 1:length(types)
        bm = benchmarks.(types{k});
        score = 0;

        % Fund freq match gives strong weight
        if fundFreq >= bm.fundRange(1) && fundFreq <= bm.fundRange(2)
            score = score + 3;
        end

        % Number of significant peaks close to benchmark
        peakDiff = abs(numSigPeaks - bm.numSig);
        score = score + max(0, 2 - peakDiff/1000); % scale weight

        % Mean spacing comparison
        if ~isnan(meanSpacing)
            spacingDiff = abs(meanSpacing - bm.meanSpacing);
            score = score + max(0, 1 - spacingDiff/5); % scale weight
        end

        scores(k) = score;
    end

    % ---------- Determine classification ----------
    [maxScore, idx] = max(scores);
    if maxScore == 0
        MusicType = 'Unknown';
    else
        MusicType = types{idx};
    end

    % ---------- Output ----------
    fprintf('File: %s\n', fileName);
    fprintf('Fundamental frequency: %.2f Hz\n', fundFreq);
    fprintf('Number of significant peaks: %d\n', numSigPeaks);
    fprintf('Mean spacing: %.2f Hz\n', meanSpacing);
    fprintf('Classified as: %s\n', MusicType);

end


