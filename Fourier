% This uploads and analyzes sound files and plots power spectrum

clear all; close all; clc;

Dir = fullfile(pwd, 'Sound Clips', 'Chosen Clips');
cd(Dir)

GetDir = dir('*.aifc');

% Loop through each sound file in the directory
for i = 1:length(GetDir)
    fileName = GetDir(i).name;
    [Sounds, fs] = audioread(fileName);
    t = 0:1/fs:(length(Sounds)-1)/fs;
    
    figure(1);
    subplot(2,2,i);
    plot(t, Sounds(:, 1));             % Plot left channel sound against time
    xlabel('Time (s)');
    ylabel('Amplitude');
    [~, SoundName, ~] = fileparts(fileName);
    title(['Raw Audio Signal for ' SoundName]);
    
    % ----- FFT / Power spectrum -----
    N    = length(Sounds(:,1));
    freq = 0:fs/N:fs/2;
    xdft = fft(Sounds(:,1), N);
    xdft = xdft(1:N/2+1);
    psdx = (1/(fs*N))*abs(xdft).^2;
    psdx(2:end-1) = 2*psdx(2:end-1);

    figure(2)
    subplot(2, 2, i)
    plot(freq, psdx)
    title(['Power Spectrum of ' SoundName])
    xlabel("Frequency (Hz)")
    ylabel("Power Spectral Density (V^2/Hz)")

    % ----- Peak analysis -----
    [Peaks, Locs] = findpeaks(psdx, freq);  % Peaks at frequencies Locs

    % Sort peaks from tallest to shortest
    [~, idxSort] = sort(Peaks, 'descend');
    sortedFreqs  = Locs(idxSort);

    % Use up to the top 3 peak frequencies
    nUse = min(3, numel(sortedFreqs));
    topFreqs = sortedFreqs(1:nUse);

    % Fundamental frequency = tallest peak
    fundFreq = topFreqs(1);

    % Average spacing between those top frequencies
    if nUse > 1
        spacing = diff(topFreqs);       % differences between adjacent top freqs
        avgSpacing = mean(spacing);
    else
        avgSpacing = NaN;               % not defined if only 1 peak
    end

    % ----- Print only the desired outputs -----
    fprintf('\n==== %s ====\n', SoundName);
    fprintf('Fundamental frequency: %.2f Hz\n', fundFreq);
    fprintf('Average spacing (top %d freqs): %.2f Hz\n', nUse, avgSpacing);

end
