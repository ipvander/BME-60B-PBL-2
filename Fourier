% Ian Van Der Linde, Ryan Shabbak, Trevor Holmgren
% 11/15/2025
function MusicType = Shazam(fileName)
% Shazam  Classifies a sound clip as Animals, Classical, Country, EDM, or Unknown

    % Reads the audio
    [Sounds, fs] = audioread(fileName); % Read audio file and sampling rate
    left         = Sounds(:,1); % Use left channel only

    % Plot raw audio 
    figure; %Set to new figure
    subplot(2,1,1); %Assign current sound plot to subplot
    plot(t, left); %Plot sounds over time
    xlabel('Time (s)'); %Label x axis
    ylabel('Amplitude'); %Label y axis
    [~, SoundName, ~] = fileparts(fileName); %Extract SoundName from file
    title(['Raw Audio Signal for ' SoundName]); %Soft code title

    % FFT/power spectrum
    N    = length(left); % Number of samples in signal
    xdft = fft(left, N); % Compute N-point FFT
    xdft = xdft(1:floor(N/2)+1); % Keep positive frequency components only

    freq = 0:fs/N:fs/2; % Frequency vector from 0 to Nyquist
    freq = freq(1:length(xdft)); % Trim frequency vector to match FFT length

    psdx = (1/(fs*N)) * abs(xdft).^2; % Convert FFT to power spectral density
    psdx(2:end-1) = 2*psdx(2:end-1); % Double interior values (fold negative freqs)

    % Plot Power Spectrum 
    subplot(2,1,2); %Assign current power spectrum to subplot
    plot(freq, psdx); %Plot power spectrum
    title(['Power Spectrum of ' SoundName]); %Soft code title
    xlabel('Frequency (Hz)'); %Lable x axis
    ylabel('Power Spectral Density (V^2/Hz)'); %Label y axis
    grid on; %Turn on grid for visibility

    % Peaks analysis
    [Peaks, Locs] = findpeaks(psdx, freq); % Find spectral peaks and their frequencies

    if isempty(Peaks) % If no peaks are found
        MusicType = 'Unknown'; % Return "Unknown"
        fprintf('\nFile: %s\n  (no peaks found)\n', fileName); % Print message
        return; % Exit function
    end % End empty peak check

    peakThresh   = 0.10 * max(Peaks); % Threshold = 10% of maximum peak height
    strongMask   = Peaks >= peakThresh; % Logical mask for "strong" peaks
    strongPeaks  = Peaks(strongMask); % Strong peak heights
    strongLocs   = Locs(strongMask); % Strong peak frequencies

    if isempty(strongPeaks) % If no peaks pass the threshold
        strongPeaks = Peaks; % Fall back to all peaks
        strongLocs  = Locs; % Use all peak locations
    end % End fallback check

    [~, idxMax] = max(strongPeaks); % Index of largest strong peak
    fundFreq    = strongLocs(idxMax); % Fundamental frequency (dominant strong peak)

    [~, idxSort] = sort(strongPeaks, 'descend'); % Sort strong peaks by height (descending)
    sortedFreqs  = strongLocs(idxSort); % Reorder frequencies by peak height
    topFreqs     = sortedFreqs(1:min(10, length(sortedFreqs))); % Take top 10 strong frequencies

    topFreqs = sort(topFreqs); % Sort chosen peaks by frequency
    if numel(topFreqs) > 1 % If more than one peak is available
        spacing = diff(topFreqs); % Frequency differences between peaks
        meanSpacing = mean(spacing); % Average spacing between top peaks
    else % If only one peak is available
        meanSpacing = NaN; % Spacing is undefined (set to NaN)
    end % End spacing calculation

    numPeaks = numel(strongPeaks); % Count total number of strong peaks

    % Print information
    fprintf('\nFile: %s\n', fileName); % Print file name
    fprintf('  fundFreq    = %.2f Hz\n', fundFreq); % Print fundamental frequency
    fprintf('  meanSpacing = %.2f Hz\n', meanSpacing); % Print mean spacing
    fprintf('  numPeaks    = %d\n',     numPeaks);  % Print number of strong peaks

    % Classification ranges

    inRange = @(val, R) ~isnan(val) && val >= R(1) && val <= R(2); % Checks value in [min max]

    % Animals reference values (from analysis script)
    % animals.aifc: fundamental 912 Hz, many peaks, small spacing
    % lion.aifc: fundamental 132 Hz, many peaks, small spacing
    animalFundRange1 = [880 950]; % Main fundamental range for animals sound file
    animalFundRange2 = [130 135]; % Narrow second range to capture lion but not others
    animalSpacingRange = [0   25]; % Allowed mean spacing for animal sounds
    animalPeaksRange = [100 500]; % Allowed number of strong peaks for animals

    %Classical reference values
    % classical.aifc: fundamental 1075 Hz, moderate spacing and peaks
    classicalFundRange = [1020 1120]; % Allowed fundamental range for classical
    classicalSpacingRange = [8   40]; % Allowed mean spacing range for classical
    classicalPeaksRange = [30  120]; % Allowed number of strong peaks for classical

    % Country reference values
    % country.aifc: fundamental 882 Hz (plus lower harmonic range near 590 Hz)
    countryFundRange1 = [560 620]; % Optional lower fundamental range for country
    countryFundRange2 = [840 920]; % Main fundamental range for country
    countrySpacingRange = [15  55]; % Allowed mean spacing range for country
    countryPeaksRange = [60  260]; % Allowed number of strong peaks for country

    % EDM reference values (many random meme sounds fall in here)
    % Fundamentals:EDM 32 Hz; pop/EDM around 45–110 Hz
    edmFundRange = [25 110]; % Single fundamental range for EDM
    edmSpacingRange = [0.5 8.0]; % EDM has relatively small peak spacing
    edmMaxPeaks = 250; % Upper limit on peaks to avoid "talking cat"

    % IF/ELSE classifiers

    if ( inRange(fundFreq, animalFundRange1) || ... % If in main animal fundfreq range
         inRange(fundFreq, animalFundRange2) ) && ... % or in lion specific range
       (isnan(meanSpacing) || inRange(meanSpacing, animalSpacingRange)) && ... % And spacing in range or NaN
       inRange(numPeaks, animalPeaksRange) % And number of peaks within animal range

        MusicType = 'Animals'; % Classify as Animals

    elseif inRange(fundFreq, classicalFundRange) && ... % Else if in classical fundfreq range
           (isnan(meanSpacing) || inRange(meanSpacing, classicalSpacingRange)) && ... % And spacing in range or Nan
           inRange(numPeaks, classicalPeaksRange) % And peaks in classical range

        MusicType = 'Classical'; % Classify as Classical

    elseif ( inRange(fundFreq, countryFundRange1) || ... % Else if in either country range
             inRange(fundFreq, countryFundRange2) ) && ... % includes both ranges
           (isnan(meanSpacing) || inRange(meanSpacing, countrySpacingRange)) && ... % And spacing in range or NaN
           inRange(numPeaks, countryPeaksRange) % And peaks in country range

        MusicType = 'Country'; % Classify as Country

    elseif inRange(fundFreq, edmFundRange) && ... % Else if fundFreq in EDM range
           (isnan(meanSpacing) || inRange(meanSpacing, edmSpacingRange)) && ... % And spacing in range or NaN
           (numPeaks <= edmMaxPeaks) % And not too many peaks

        MusicType = 'EDM'; % Classify as EDM

    else % If none of the above matches
        MusicType = 'Unknown'; % Classify as Unknown
    end % End if/elseif

    fprintf('Classified as: %s\n', MusicType); % Print final classification to Command Window
end % End of Shazam function
