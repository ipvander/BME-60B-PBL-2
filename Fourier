%testShazam script
% Script to test our Shazam function on known and unknown sound clips
clear; clc; close all;
fprintf('Testing Shazam.m\n\n');
% Test all of the 4 known sound files
% Runs the Shazam classifier on a small set of labeled training clips
knownFiles = { ...
    'animals.aifc', ...
    'classical.aifc', ...
    'country.aifc', ...
    'edm.aifc' };
knownLabels = { ...
    'Animals', ...
    'Classical', ...
    'Country', ...
    'EDM' };
fprintf('Known files:\n');
for k = 1:numel(knownFiles)
    file = knownFiles{k};
    expected = knownLabels{k};
    if exist(file, 'file')
        musicType = Shazam(file);
        fprintf('Expected: %s\n\n', expected);
    else
        fprintf('  File not found in current folder. Skipping.\n\n');
    end
end
% Test all of the unknown sound files
% Runs Shazam on several unknown files and print results
unknownFiles = { ...
    'all star inverted.aifc', ...
    'all star.aifc', ...
    'blue.aifc', ...
    'careless whisper.aifc', ...
    'despacito.aifc', ...
    'drake.aifc', ...
    'friday.aifc', ...
    'kekistan.aifc', ...
    'lion.aifc', ...
    'peanut butter jelly time.aifc', ...
    'rick roll.aifc', ...
    'talking cat.aifc', ...
    'what is love.aifc', ...
    'x files.aifc' };
fprintf('Testing Unknown Files:\n\n');
for k = 1:numel(unknownFiles)
    file = unknownFiles{k};
    fprintf('Testing file: %s\n', file);
    if exist(file, 'file')
        musicType = Shazam(file);
        fprintf('  Shazam classification: %s\n\n', musicType);
    else
        fprintf('  File not found in current folder. Skipping.\n\n');
    end
end
fprintf('All tests complete.\n');
